{
  "name": "chinese-friend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,ocr -c cyan,magenta,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:ocr:dev\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "ocr:setup": "bash ocr/setup.sh",
    "ocr:dev": "bash ocr/run.sh",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "fixtures": "python3 scripts/make-fixtures.py",
    "check:ocr": "tsx scripts/check-ocr.ts",
    "check:tts": "tsx scripts/check-tts.ts"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pinyin-tone2": "^1.3.1",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
