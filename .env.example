# Server-side only. Do not prefix these with VITE_, or they will be
# bundled into the browser build.

# Text model used to translate, explain, and write an example.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local OCR + pinyin sidecar. Start it with `npm run ocr:dev`.
OCR_URL=http://127.0.0.1:7861
OCR_PORT=7861

# Mandarin text-to-speech (Azure Speech).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural

# Express port. The Vite dev server proxies /api here.
PORT=3001
